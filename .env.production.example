# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only Supabase Admin Key (Required for server operations)
# Get this from Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Production Site URL
# Update this to your actual Vercel deployment URL after deployment
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Clinic Organization Configuration
# These IDs should match your actual Supabase database records
CLINIC_ORGANIZATION_ID=your-organization-uuid
CLINIC_DEFAULT_FACILITY_ID=your-facility-uuid
